# Copy to .env (git-ignored) and fill in. Never commit .env.
LLM_PROVIDER=gemini
# Pinned model; avoid gemini-flash-latest (often overloaded). Check with `incident-agent models`.
GEMINI_MODEL=gemini-3.5-flash
# Used when the primary is overloaded or times out. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=60
GOOGLE_API_KEY=

# Mock data set used by `incident-agent chat` (see fixtures/scenarios/).
MOCK_SCENARIO=merchant_down
MAX_TOOL_CALLS_PER_TURN=15
